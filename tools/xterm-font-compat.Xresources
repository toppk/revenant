! Curated inputs for tools/check-xterm-font-compat.
! Keep these instance/widget names exact so command-line -xrm entries override
! a user's live RESOURCE_MANAGER database without changing it.
xterm.vt100.renderFont: true
xterm.vt100.faceName: DejaVu Sans Mono:size=11:rgba=none
xterm.vt100.faceNameDoublesize:
xterm.vt100.faceNameEmoji:

! The embedded 11-point size must override this deliberately conflicting value.
xterm.vt100.faceSize: 16
xterm.vt100.faceSize1: 6
xterm.vt100.faceSize2: 8
xterm.vt100.faceSize3: 10
xterm.vt100.faceSize4: 13
xterm.vt100.faceSize5: 16
xterm.vt100.faceSize6: 20
xterm.vt100.faceSize7: 24

! Xterm initializes its core-font menu even while renderFont is enabled.
xterm.vt100.font: fixed
xterm.vt100.font1: nil2
xterm.vt100.font2: 5x7
xterm.vt100.font3: 6x10
xterm.vt100.font4: 7x13
xterm.vt100.font5: 9x15
xterm.vt100.font6: 10x20
xterm.vt100.font7: 12x24

xterm.vt100.internalBorder: 4
xterm.vt100.scrollBar: false
xterm.vt100.rightScrollBar: false
xterm.vt100.backgroundOpacity: 1
xterm.vt100.allowSendEvents: true
