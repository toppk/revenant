#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Generate xterm+'s compact Script=Han ranges from Unicode Scripts.txt."""

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

VERSION_RE = re.compile(r"^# Scripts-([0-9]+(?:\.[0-9]+)*)\.txt$")
SCRIPT_RE = re.compile(
    r"^([0-9A-F]+)(?:\.\.([0-9A-F]+))?\s*;\s*Han\s*(?:#|$)"
)


def parse(path: Path) -> tuple[str, list[tuple[int, int]]]:
    version = None
    ranges: list[tuple[int, int]] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        version_match = VERSION_RE.match(line)
        if version_match is not None:
            version = version_match.group(1)
        script_match = SCRIPT_RE.match(line)
        if script_match is not None:
            ranges.append(
                (
                    int(script_match.group(1), 16),
                    int(script_match.group(2) or script_match.group(1), 16),
                )
            )
    if version is None:
        raise ValueError(f"{path}: missing Scripts version header")
    if not ranges:
        raise ValueError(f"{path}: contains no Script=Han ranges")
    return version, ranges


def render(source: Path, version: str, ranges: list[tuple[int, int]]) -> str:
    digest = hashlib.sha256(source.read_bytes()).hexdigest()
    lines = [
        "/* Generated by tools/generate-han-table; do not edit. */",
        "/* clang-format off */",
        f"/* Unicode {version}; Scripts.txt SHA-256 {digest}. */",
        f'#define XTP_HAN_UNICODE_VERSION "{version}"',
        "",
        "static const XtpUnicodeRange xtp_han_ranges[] = {",
    ]
    for first, last in ranges:
        lines.append(f"    {{0x{first:06x}U, 0x{last:06x}U}},")
    lines.extend(("};", "", "/* clang-format on */"))
    return "\n".join(lines)


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    scripts_inputs = sorted(
        (root / "upstream/ghostty/zig-pkg").glob("uucode-*/ucd/Scripts.txt")
    )
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--input",
        type=Path,
        default=scripts_inputs[0] if len(scripts_inputs) == 1 else None,
    )
    parser.add_argument(
        "--manifest",
        type=Path,
        default=root / "tools/font-fixtures/manifest.json",
    )
    parser.add_argument(
        "--output", type=Path, default=root / "src/han_ranges.h"
    )
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()

    if args.input is None:
        print("cannot identify exactly one libghostty Scripts.txt", file=sys.stderr)
        return 1
    expected = json.loads(args.manifest.read_text(encoding="utf-8")).get(
        "unicode_version"
    )
    source_version, ranges = parse(args.input)
    version = ".".join(source_version.split(".")[:2])
    if version != expected:
        print(
            f"Unicode version mismatch: Scripts={source_version!r} manifest={expected!r}",
            file=sys.stderr,
        )
        return 1
    generated = render(args.input, version, ranges)
    if args.check:
        current = (
            args.output.read_text(encoding="utf-8")
            if args.output.is_file()
            else None
        )
        if current != generated:
            print(f"generated Han table is stale: {args.output}", file=sys.stderr)
            return 1
        print(f"Han table matches Unicode {version}: {len(ranges)} ranges")
        return 0
    args.output.write_text(generated, encoding="utf-8")
    print(f"generated {args.output} from Unicode {version}: {len(ranges)} ranges")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
