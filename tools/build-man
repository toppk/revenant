#!/usr/bin/env python3
"""Build the section-1 manual page: regenerate fragments, inline them, run pandoc."""

import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
INCLUDE = re.compile(r'^--8<--\s+"([^"]+)"\s*$')


def main():
    if len(sys.argv) < 3:
        raise SystemExit(f"usage: {sys.argv[0]} SKELETON.md OUTPUT [PANDOC] [FOOTER]")
    skeleton, output = Path(sys.argv[1]), Path(sys.argv[2])
    pandoc = sys.argv[3] if len(sys.argv) > 3 else "pandoc"
    footer = sys.argv[4] if len(sys.argv) > 4 else "development build"
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as scratch:
        fragments = Path(scratch) / "fragments"
        subprocess.run([sys.executable, str(ROOT / "tools/generate-doc-fragments"), str(fragments)], check=True)
        lines = []
        for line in skeleton.read_text(encoding="utf-8").splitlines():
            match = INCLUDE.match(line)
            if match:
                lines.append((fragments / match.group(1)).read_text(encoding="utf-8"))
            else:
                lines.append(line)
        source = Path(scratch) / "manual.1.md"
        source.write_text("\n".join(lines) + "\n", encoding="utf-8")
        subprocess.run(
            [pandoc, "--standalone", "--from", "markdown", "--to", "man",
             "--variable", f"footer:{footer}", "--output", str(output), str(source)],
            check=True,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
