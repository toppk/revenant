)
readonly sources

list_sources()
{
	printf 'id\tfilename\tsha256\turl\n'
	while IFS='|' read -r id filename sha url; do
		printf '%s\t%s\t%s\t%s\n' "$id" "$filename" "$sha" "$url"
	done <<<"$sources"
}

while (($# != 0)); do
	case $1 in
	--seed)
		if (($# < 2)); then
			echo "--seed requires a directory" >&2
			exit 2
		fi
		seed_dirs+=("$(CDPATH='' cd -- "$2" && pwd)")
		shift 2
		;;
	--offline)
		offline=true
		shift
		;;
	--list)
		list_sources
		exit 0
		;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		printf 'unknown option: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	*)
		break
		;;
	esac
done
if (($# > 1)); then
	usage >&2
	exit 2
fi
if (($# == 1)); then
	case $1 in
	/*) output=$1 ;;
	*) output="$PWD/$1" ;;
	esac
fi

if [[ -e $output ]]; then
	printf 'refusing to replace existing output: %s\n' "$output" >&2
	exit 1
fi
if [[ ! -d $(dirname -- "$output") ]]; then
	printf 'output parent does not exist: %s\n' "$(dirname -- "$output")" >&2
	exit 1
fi

work=$(mktemp -d "$(dirname -- "$output")/.font-fixtures.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
mkdir -p "$work/sources" "$work/fonts" "$work/licenses" "$work/data" "$work/universes"

for command in cpio curl python3 rpm2cpio sha256sum tar unzip; do
	if ! command -v "$command" >/dev/null 2>&1; then
		printf 'required command is unavailable: %s\n' "$command" >&2
		exit 1
	fi
done
if ! python3 -c 'import fontTools' >/dev/null 2>&1; then
	echo "Python fontTools is required to generate the sbix fixture" >&2
	exit 1
fi

verified()
{
	local path=$1
	local expected=$2
	local actual

	[[ -f $path ]] || return 1
	actual=$(sha256sum -- "$path")
	actual=${actual%% *}
	[[ $actual == "$expected" ]]
}

fetch_source()
{
	local id=$1
	local filename=$2
	local expected=$3
	local url=$4
	local destination="$work/sources/$filename"
	local seed candidate

	for seed in "${seed_dirs[@]}"; do
		candidate="$seed/$filename"
		if [[ -e $candidate ]]; then
			if ! verified "$candidate" "$expected"; then
				printf 'seed has wrong SHA-256: %s\n' "$candidate" >&2
				exit 1
			fi
			cp -- "$candidate" "$destination"
			printf 'seeded %-24s %s\n' "$id" "$candidate"
			return
		fi
	done

	if $offline; then
		printf 'offline source is missing: %s\n' "$filename" >&2
		exit 1
	fi
	printf 'fetching %-23s %s\n' "$id" "$url"
	curl -L --fail --silent --show-error --output "$destination" "$url"
	if ! verified "$destination" "$expected"; then
		printf 'download has wrong SHA-256: %s\n' "$url" >&2
		exit 1
	fi
}

while IFS='|' read -r id filename sha url; do
	fetch_source "$id" "$filename" "$sha" "$url"
done <<<"$sources"

extract_zip()
{
	local archive=$1
	local member=$2
	local destination=$3

	if ! unzip -p "$work/sources/$archive" "$member" >"$destination"; then
		printf 'cannot extract %s from %s\n' "$member" "$archive" >&2
		exit 1
	fi
}

extract_zip dejavu-fonts-ttf-2.37.zip \
	dejavu-fonts-ttf-2.37/ttf/DejaVuSansMono.ttf \
	"$work/fonts/DejaVuSansMono.ttf"
extract_zip dejavu-fonts-ttf-2.37.zip \
	dejavu-fonts-ttf-2.37/ttf/DejaVuSansMono-Bold.ttf \
	"$work/fonts/DejaVuSansMono-Bold.ttf"
extract_zip dejavu-fonts-ttf-2.37.zip \
	dejavu-fonts-ttf-2.37/ttf/DejaVuSansMono-Oblique.ttf \
	"$work/fonts/DejaVuSansMono-Oblique.ttf"
extract_zip dejavu-fonts-ttf-2.37.zip \
	dejavu-fonts-ttf-2.37/ttf/DejaVuSansMono-BoldOblique.ttf \
