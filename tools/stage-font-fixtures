	NotoColorEmoji-2.034.ttf OpenMoji-COLRv0.ttf
make_universe shaping "${base_fonts[@]}" \
	NotoSansDevanagari-Regular.ttf NotoSansDevanagari-Bold.ttf \
	NotoSansMonoCJKjp-Regular.otf NotoSansMonoCJKjp-Bold.otf

{
	printf 'path\tsha256\tsource\tlicense\n'
	for path in "$work/fonts"/*; do
		filename=${path##*/}
		case $filename in
		DejaVu*) source=dejavu-2.37; license=licenses/DejaVu-2.37.txt ;;
		NotoSansDevanagari*)
			source=noto-devanagari-2.006
			license=licenses/NotoSansDevanagari-2.006.txt
			;;
		NotoSansMonoCJK*) source=noto-cjk-sans-2.004; license=licenses/NotoSansCJK-2.004.txt ;;
		Noto-COLRv1.ttf | NotoColorEmoji.ttf)
			source=noto-emoji-2.051; license=licenses/NotoEmoji-2.051.txt ;;
		NotoColorEmoji-2.034.ttf)
			source=noto-emoji-2.034; license=licenses/NotoEmoji-2.034.txt ;;
		NotoEmoji-Regular.ttf)
			source=noto-emoji-2.028; license=licenses/NotoEmoji-2.028.txt ;;
		OpenMoji-COLRv0.ttf)
			source=openmoji-17.0.0
			license=licenses/OpenMoji-17.0.0-CC-BY-SA-4.0.txt
			;;
		Twemoji.ttf)
			source=fedora-twitter-twemoji-14.0.2-10+twemoji-source-14.0.2
			license=licenses/Twemoji-14.0.2-CC-BY-4.0.txt
			;;
		TwitterColorEmoji-SVGinOT.ttf)
			source=twitter-color-emoji-15.1.0
			license=licenses/TwitterColorEmoji-CC-BY-4.0.txt
			;;
		RevenantSyntheticSbix.ttf)
			source=generated-revenant-sbix
			license=licenses/Revenant-MIT.txt
			;;
		*) echo "unmapped staged font: $filename" >&2; exit 1 ;;
		esac
		sha=$(sha256sum -- "$path")
		printf 'fonts/%s\t%s\t%s\t%s\n' "$filename" "${sha%% *}" "$source" "$license"
	done
} >"$work/MANIFEST.tsv"

{
	printf 'id\tfilename\tsha256\turl\n'
	while IFS='|' read -r id filename sha url; do
		printf '%s\t%s\t%s\t%s\n' "$id" "$filename" "$sha" "$url"
	done <<<"$sources"
} >"$work/SOURCES.tsv"

cp -- "$project_root/tools/font-fixtures/LICENSES.md" "$work/LICENSES.md"
cp -- "$project_root/tools/font-fixtures/manifest.json" "$work/manifest.json"

cat >"$work/run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

fixture_root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
readonly fixture_root
if (($# < 2)); then
	echo "usage: run UNIVERSE COMMAND [ARG ...]" >&2
	exit 2
fi
readonly universe=$1
shift
readonly universe_root="$fixture_root/universes/$universe"
if [[ ! -f $universe_root/fontconfig.conf ]]; then
	printf 'unknown fixture universe: %s\n' "$universe" >&2
	exit 2
fi
mkdir -p "$universe_root/cache"
export FONTCONFIG_FILE="$universe_root/fontconfig.conf"
export XDG_CACHE_HOME="$universe_root/cache"
exec "$@"
EOF
chmod +x "$work/run"

cat >"$work/README.md" <<'EOF'
# Revenant font fixture staging tree

This directory was generated by `tools/stage-font-fixtures`. It is an
inspection intermediate, not a committed fixture bundle. Every source is
pinned by SHA-256 in `SOURCES.tsv`; every extracted font and its license are
mapped in `MANIFEST.tsv`.

The base face is DejaVu Sans Mono Regular/Bold/Oblique/Bold Oblique. It covers ordinary terminal
text and selected text-presentation symbols without supplying CJK or the
supplementary emoji range. The CJK role is the standalone, non-variable Noto
Sans Mono CJK JP Regular/Bold release. Those faces also exercise CFF outlines
and the OpenType ceiling of 65,535 glyphs. Emoji faces cover high- and
low-resolution CBDT, COLRv0, COLRv1, SVGinOT with outline fallback,
monochrome outlines, and synthetic sbix.

Each directory below `universes/` is a self-contained Fontconfig universe.
Its configuration uses only that universe's `fonts/` links and private
`cache/`; it does not include the host configuration. For example:

```sh
font-fixtures-stage/run cjk-emoji fc-list
font-fixtures-stage/run colrv1 fc-match 'Noto Color Emoji'
```

To classify all staged fonts or verify their hashes, table types, axes,
strikes, coverage, and per-probe ink paths:

```sh
tools/font-fixture-info.py --dir font-fixtures-stage/fonts
tools/font-fixture-info.py --check font-fixtures-stage/manifest.json
```

The manifest's top-level `outline` value names the outline table technology;
the per-probe paths report actual nonempty ink. In particular, a `glyf` font
whose probe says only `color` or `bitmap` has an empty outline base for that
probe. See the maintained `tools/font-fixtures/README.md` for the full schema
contract.

The `empty` universe deliberately contains no fonts. The `base`, `cbdt`,
`cbdt-legacy`, `cbdt-lowres`, `colrv0`, `colrv1`, `mono`, `svginot`,
`atomic-tag`, `sbix`, `cjk`, `cjk-emoji`, `routing`, `legacy-routing`, and `shaping`
universes isolate the remaining rendering and fallback scenarios. Moving this
entire tree is safe because its Fontconfig paths and font links are relative.
EOF

python3 "$project_root/tools/font-fixture-info.py" --check "$work/manifest.json"

# Exercise the generated configurations before publishing the tree.  fc-list
# must see exactly the symlinked files and must not leak host fonts.
if command -v fc-list >/dev/null 2>&1; then
	for universe in "$work/universes"/*; do
		expected=$(find "$universe/fonts" -type l | wc -l)
		actual=$(XDG_CACHE_HOME="$universe/cache" \
			FONTCONFIG_FILE="$universe/fontconfig.conf" fc-list : file | \
			sed -n 's/:.*//p' | sort -u | wc -l)
		if [[ $actual -ne $expected ]]; then
			printf 'Fontconfig universe %s has %s files; expected %s\n' \
				"${universe##*/}" "$actual" "$expected" >&2
			exit 1
		fi
	done
fi

mv -- "$work" "$output"
trap - EXIT
printf '\nstaged font fixtures in %s\n' "$output"
printf 'inspect with: tools/font-fixture-info.py --check %q\n' "$output/manifest.json"
