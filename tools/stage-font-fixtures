#!/usr/bin/env bash
set -euo pipefail

# Build an inspectable, isolated font fixture tree from pinned upstream
# releases.  This deliberately does not read individual installed fonts: an
# archive is accepted only when it has the expected upstream SHA-256.

project_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
readonly project_root
output="$project_root/font-fixtures-stage"
offline=false
declare -a seed_dirs=()

usage()
{
	cat <<EOF
usage: tools/stage-font-fixtures [OPTIONS] [OUTPUT]

Create a new, inspectable font-fixture tree.  OUTPUT must not exist.

  --seed DIR   reuse verified downloads from DIR (may be repeated)
  --offline    fail rather than download a missing source
  --list       print the pinned source inventory and exit
  -h, --help   show this help

The existing fonttest/ directory is never modified.  To reuse its archives:

  tools/stage-font-fixtures --seed fonttest
EOF
}

# id|filename|sha256|url
sources=$(cat <<'EOF'
