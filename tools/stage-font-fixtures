make_universe base "${base_fonts[@]}"
make_universe cbdt "${base_fonts[@]}" NotoColorEmoji.ttf
make_universe cbdt-legacy "${base_fonts[@]}" NotoColorEmoji-2.034.ttf
make_universe cbdt-lowres "${base_fonts[@]}" Twemoji.ttf
make_universe colrv0 "${base_fonts[@]}" OpenMoji-COLRv0.ttf
make_universe colrv1 "${base_fonts[@]}" Noto-COLRv1.ttf
make_universe mono "${base_fonts[@]}" NotoEmoji-Regular.ttf
make_universe svginot "${base_fonts[@]}" TwitterColorEmoji-SVGinOT.ttf
make_universe atomic-tag "${base_fonts[@]}" \
	TwitterColorEmoji-SVGinOT.ttf Noto-COLRv1.ttf
make_universe sbix "${base_fonts[@]}" RevenantSyntheticSbix.ttf
make_universe cjk "${base_fonts[@]}" \
	NotoSansMonoCJKjp-Regular.otf NotoSansMonoCJKjp-Bold.otf
make_universe cjk-emoji "${base_fonts[@]}" \
	NotoSansMonoCJKjp-Regular.otf NotoSansMonoCJKjp-Bold.otf Noto-COLRv1.ttf
make_universe routing "${base_fonts[@]}" \
	NotoSansMonoCJKjp-Regular.otf NotoSansMonoCJKjp-Bold.otf \
	NotoEmoji-Regular.ttf Noto-COLRv1.ttf
