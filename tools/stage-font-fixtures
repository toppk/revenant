make_universe()
{
	local name=$1
	shift
	local directory="$work/universes/$name"
	local font

	mkdir -p "$directory/fonts" "$directory/cache"
	for font in "$@"; do
		if [[ ! -f $work/fonts/$font ]]; then
			printf 'universe %s names missing font %s\n' "$name" "$font" >&2
			exit 1
		fi
		ln -s "../../../fonts/$font" "$directory/fonts/$font"
	done
	cat >"$directory/fontconfig.conf" <<'EOF'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <dir prefix="relative">fonts</dir>
  <cachedir prefix="xdg">fontconfig</cachedir>
</fontconfig>
EOF
}

readonly base_regular=DejaVuSansMono.ttf
readonly base_bold=DejaVuSansMono-Bold.ttf
readonly base_italic=DejaVuSansMono-Oblique.ttf
readonly base_bold_italic=DejaVuSansMono-BoldOblique.ttf
readonly base_fonts=("$base_regular" "$base_bold" "$base_italic" "$base_bold_italic")
