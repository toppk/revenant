#!/usr/bin/env bash
set -euo pipefail

readonly revision=f64f4aca2c29b554d111b36c3d946a9bddd159ff
readonly repository=https://github.com/ghostty-org/ghostty.git
readonly project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
readonly destination="$project_root/upstream/ghostty"

if [[ -e "$destination/.git" ]]; then
    if ! git -C "$destination" diff --quiet ||
       ! git -C "$destination" diff --cached --quiet; then
        echo "refusing to replace changes in $destination" >&2
        exit 1
    fi
    git -C "$destination" fetch origin "$revision"
else
    mkdir -p "$(dirname -- "$destination")"
    git clone "$repository" "$destination"
fi

git -C "$destination" checkout --detach "$revision"
test "$(git -C "$destination" rev-parse HEAD)" = "$revision"
printf 'libghostty source pinned at %s\n' "$revision"

