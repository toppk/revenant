#!/usr/bin/env bash
set -euo pipefail

readonly reference=5aeb693b7727b0dc6fcc9193bc1d2453af3bcb9a
readonly repository=https://github.com/ghostty-org/ghostty.git
# A branch or tag would move under the CI cache key and between release jobs.
if [[ ! $reference =~ ^[0-9a-f]{40}$ ]]; then
    echo "fetch-libghostty: reference must be a full commit hash, got '$reference'" >&2
    exit 1
fi
if [[ ${1:-} == --print-reference ]]; then
    echo "$reference"
    exit 0
fi
project_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
readonly project_root
readonly destination="$project_root/upstream/ghostty"

if [[ -e "$destination/.git" ]]; then
    if ! git -C "$destination" diff --quiet ||
       ! git -C "$destination" diff --cached --quiet; then
        echo "refusing to replace changes in $destination" >&2
        exit 1
    fi
else
    mkdir -p "$(dirname -- "$destination")"
    git clone "$repository" "$destination"
fi

git -C "$destination" fetch origin "$reference"
revision=$(git -C "$destination" rev-parse FETCH_HEAD)
readonly revision
git -C "$destination" checkout --detach "$revision"
test "$(git -C "$destination" rev-parse HEAD)" = "$revision"
printf 'libghostty source selected from %s at %s\n' "$reference" "$revision"
