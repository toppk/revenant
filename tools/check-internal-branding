#!/usr/bin/env python3
"""Reject product branding from internal implementation and test trees."""

from pathlib import Path
import re
import sys


INTERNAL_TREES = ("src", "tools", "tests")
FORBIDDEN = "reve" + "nant"
BRANDED_TOOL_DEMOS = {"tools/demo.sh"}
# Generated external specification identifiers are reference data, not internal
# product names. TDN tests require this snapshot to match its source registry.
BRANDED_REFERENCE_DATA = {"tools/probe/data/features.json"}
# Public X11 protocol identifiers must match the published discovery contract.
# This permits those exact tokens, not product branding in implementation names.
PUBLIC_X11_NAMES = re.compile(
    r"(?<![A-Za-z0-9_])_REVE"
    r"NANT_(?:VERSION|CAPABILITIES|RELOAD_SIGHUP_V1)(?![A-Za-z0-9_])"
)


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: tools/check-internal-branding SOURCE_ROOT", file=sys.stderr)
        return 2

    source_root = Path(sys.argv[1])
    findings: list[str] = []
    for tree_name in INTERNAL_TREES:
        tree = source_root / tree_name
        for path in sorted(tree.rglob("*")):
            if not path.is_file() or "__pycache__" in path.parts:
                continue
            relative_path = path.relative_to(source_root)
            if str(relative_path) in BRANDED_TOOL_DEMOS | BRANDED_REFERENCE_DATA:
                continue
            for line_number, line in enumerate(
                path.read_text(encoding="utf-8", errors="replace").splitlines(), 1
            ):
                # Literal newline escapes also delimit tokens in Python/C fixtures.
                candidate = line.replace(r"\n", "\n")
                if FORBIDDEN in PUBLIC_X11_NAMES.sub("", candidate).casefold():
                    findings.append(f"{relative_path}:{line_number}:{line}")

    if findings:
        print(
            "product branding is limited to documentation, Meson, packaging, and exact public X11 identifiers:",
            file=sys.stderr,
        )
        print(*findings, sep="\n", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
