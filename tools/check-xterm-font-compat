#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/.." && pwd)
build_dir=${1:-build}
terminal=${2:-}
case $build_dir in
/*) ;;
*) build_dir=$repo_root/$build_dir ;;
esac
case $terminal in
/*) ;;
'')
	printf 'usage: tools/check-xterm-font-compat BUILD_DIR XTERM_PLUS\n' >&2
	exit 2
	;;
*) terminal=$repo_root/$terminal ;;
esac

sender=$build_dir/xtp-send-font-keys
resources=$script_dir/xterm-font-compat.Xresources
run_dir=$(mktemp -d "${TMPDIR:-/tmp}/xtp-xterm-font-compat.XXXXXX")
xterm_pid=
xterm_plus_pid=
passed=false

cleanup()
{
	status=$?
	if test -n "$xterm_pid"; then
		kill "$xterm_pid" 2>/dev/null || true
		wait "$xterm_pid" 2>/dev/null || true
	fi
	if test -n "$xterm_plus_pid"; then
		kill "$xterm_plus_pid" 2>/dev/null || true
		wait "$xterm_plus_pid" 2>/dev/null || true
	fi
	if test "$passed" = true && test "$status" -eq 0; then
		rm -rf -- "$run_dir"
	else
		printf 'compatibility artifacts kept in %s\n' "$run_dir" >&2
	fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

die()
{
	printf 'check-xterm-font-compat: %s\n' "$*" >&2
	exit 1
}

for command_name in xterm xprop xwininfo wmctrl fc-match; do
	command -v "$command_name" >/dev/null 2>&1 || die "missing required command: $command_name"
done
test -n "${DISPLAY:-}" || die 'DISPLAY is unset; run this from the graphical/VNC session'
xwininfo -root >/dev/null 2>&1 || die "cannot query X display $DISPLAY"
test -x "$terminal" || die "missing $terminal; build xterm+ first"
test -x "$sender" || die "missing $sender; build xterm+ first"
test -r "$resources" || die "missing $resources"

matched_family=$(fc-match --format '%{family}\n' 'DejaVu Sans Mono' | head -1)
case $matched_family in
*DejaVu\ Sans\ Mono*) ;;
*) die "DejaVu Sans Mono is unavailable (fontconfig selected: $matched_family)" ;;
esac

resource_args=()
while IFS= read -r resource_line || test -n "$resource_line"; do
	resource_line=${resource_line%$'\r'}
	case $resource_line in
	''|'!'*|'#'*) continue ;;
	esac
	resource_args+=(-xrm "$resource_line")
done <"$resources"

tag=xtp-font-compat-$$
xterm_title=$tag-xterm
xterm_plus_title=$tag-xterm-plus
xterm_log=$run_dir/xterm.log
xterm_plus_log=$run_dir/xterm-plus.log

xterm "${resource_args[@]}" -title "$xterm_title" -geometry 80x24 \
	-e sh -c 'exec sleep 300' >"$run_dir/xterm.out" 2>"$xterm_log" &
xterm_pid=$!
"$terminal" -debug "${resource_args[@]}" -title "$xterm_plus_title" -geometry 80x24 \
	-e sh -c 'exec sleep 300' >"$run_dir/xterm-plus.out" 2>"$xterm_plus_log" &
xterm_plus_pid=$!

xterm_window=
xterm_plus_window=
for ((attempt = 0; attempt < 100; ++attempt)); do
	xterm_window=$(wmctrl -lp | awk -v pid="$xterm_pid" '$3 == pid { print $1; exit }')
	xterm_plus_window=$(sed -n 's/.*shell: realized window=\(0x[0-9a-fA-F]*\).*/\1/p' \
		"$xterm_plus_log" | tail -1)
	if test -n "$xterm_window" && test -n "$xterm_plus_window"; then
		break
	fi
	if ! kill -0 "$xterm_pid" 2>/dev/null; then
		die "xterm exited during startup; see $xterm_log"
	fi
	if ! kill -0 "$xterm_plus_pid" 2>/dev/null; then
		die "xterm+ exited during startup; see $xterm_plus_log"
	fi
	sleep 0.05
done
test -n "$xterm_window" || die "could not find xterm window titled $xterm_title"
test -n "$xterm_plus_window" || die "could not find xterm+'s realized window"

geometry_metrics()
{
	window=$1
	window_info=$(xwininfo -id "$window")
	hints=$(xprop -id "$window" WM_NORMAL_HINTS)
	width=$(awk '$1 == "Width:" { print $2; exit }' <<<"$window_info")
	height=$(awk '$1 == "Height:" { print $2; exit }' <<<"$window_info")
	program=$(sed -n 's/.*program specified size: *\([0-9][0-9]*\) by \([0-9][0-9]*\).*/\1x\2/p' \
		<<<"$hints")
	increment=$(sed -n 's/.*program specified resize increment: *\([0-9][0-9]*\) by \([0-9][0-9]*\).*/\1x\2/p' \
		<<<"$hints")
	base=$(sed -n 's/.*program specified base size: *\([0-9][0-9]*\) by \([0-9][0-9]*\).*/\1x\2/p' \
		<<<"$hints")
	test -n "$width" && test -n "$height" && test -n "$program" && test -n "$increment" &&
		test -n "$base" || die "incomplete WM_NORMAL_HINTS for window $window"
	printf 'window=%sx%s program=%s increment=%s base=%s' \
		"$width" "$height" "$program" "$increment" "$base"
}

compare_stage()
{
	stage=$1
	xterm_metrics=$(geometry_metrics "$xterm_window")
	xterm_plus_metrics=$(geometry_metrics "$xterm_plus_window")
	printf '%-8s xterm     %s\n' "$stage" "$xterm_metrics"
	printf '%-8s xterm+    %s\n' "$stage" "$xterm_plus_metrics"
	if test "$xterm_metrics" != "$xterm_plus_metrics"; then
		printf '%s geometry mismatch\n' "$stage" >&2
		return 1
	fi
}

compare_stage default
"$sender" "$xterm_window" + 8 >/dev/null
"$sender" "$xterm_plus_window" + 8 >/dev/null
compare_stage largest
"$sender" "$xterm_window" - 8 >/dev/null
"$sender" "$xterm_plus_window" - 8 >/dev/null
compare_stage smallest

printf 'xterm font geometry compatibility: OK (display %s)\n' "$DISPLAY"
passed=true
