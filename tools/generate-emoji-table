#!/usr/bin/env python3
"""Generate Revenant's compact emoji property ranges from emoji-data.txt."""

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

PROPERTIES = ("Emoji", "Emoji_Presentation")
VERSION_RE = re.compile(r"^#\s*Version:\s*([0-9]+(?:\.[0-9]+)*)\s*$")
PROPERTY_RE = re.compile(
    r"^([0-9A-F]+)(?:\.\.([0-9A-F]+))?\s*;\s*" r"(Emoji|Emoji_Presentation)\s*(?:#|$)"
)


def merge_ranges(ranges: list[tuple[int, int]]) -> list[tuple[int, int]]:
    result: list[tuple[int, int]] = []
    for first, last in sorted(ranges):
        if result and first <= result[-1][1] + 1:
            result[-1] = (result[-1][0], max(result[-1][1], last))
        else:
            result.append((first, last))
    return result


def parse(path: Path) -> tuple[str, dict[str, list[tuple[int, int]]]]:
    version = None
    properties: dict[str, list[tuple[int, int]]] = {name: [] for name in PROPERTIES}
    for line in path.read_text(encoding="utf-8").splitlines():
        version_match = VERSION_RE.match(line)
        if version_match is not None:
            version = version_match.group(1)
        property_match = PROPERTY_RE.match(line)
        if property_match is None:
            continue
        first = int(property_match.group(1), 16)
        last = int(property_match.group(2) or property_match.group(1), 16)
        properties[property_match.group(3)].append((first, last))
    if version is None:
        raise ValueError(f"{path}: missing '# Version:' header")
    for name in PROPERTIES:
        properties[name] = merge_ranges(properties[name])
        if not properties[name]:
            raise ValueError(f"{path}: property {name} has no ranges")
    return version, properties


def render(
    source: Path, version: str, properties: dict[str, list[tuple[int, int]]]
) -> str:
    digest = hashlib.sha256(source.read_bytes()).hexdigest()
    lines = [
        "/* Generated by tools/generate-emoji-table; do not edit. */",
        "/* clang-format off */",
        f"/* Unicode {version}; emoji-data.txt SHA-256 {digest}. */",
        f'#define XTP_EMOJI_UNICODE_VERSION "{version}"',
        "",
    ]
    for property_name, c_name in (
        ("Emoji", "xtp_emoji_ranges"),
        ("Emoji_Presentation", "xtp_emoji_presentation_ranges"),
    ):
        lines.append(f"static const XtpEmojiRange {c_name}[] = {{")
        for first, last in properties[property_name]:
            lines.append(f"    {{0x{first:06x}U, 0x{last:06x}U}},")
        lines.extend(("};", ""))
    lines.append("/* clang-format on */")
    return "\n".join(lines)


def main() -> int:
    project_root = Path(__file__).resolve().parent.parent
    width_inputs = sorted(
        (project_root / "upstream/ghostty/zig-pkg").glob(
            "uucode-*/ucd/emoji/emoji-data.txt"
        )
    )
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--input",
        type=Path,
        default=project_root / "font-fixtures-stage/data/emoji-data.txt",
    )
    parser.add_argument(
        "--manifest",
        type=Path,
        default=project_root / "tools/font-fixtures/manifest.json",
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=project_root / "src/emoji_ranges.h",
    )
    parser.add_argument(
        "--width-input",
        type=Path,
        default=width_inputs[0] if len(width_inputs) == 1 else None,
        help="libghostty/uucode emoji-data.txt used by the width engine",
    )
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()

    manifest = json.loads(args.manifest.read_text(encoding="utf-8"))
    version, properties = parse(args.input)
    expected_version = manifest.get("unicode_version")
    if version != expected_version:
        print(
            f"Unicode version mismatch: input={version!r} manifest={expected_version!r}",
            file=sys.stderr,
        )
        return 1
    if args.width_input is None:
        print(
            "cannot identify exactly one libghostty/uucode emoji-data.txt; "
            "pass --width-input",
            file=sys.stderr,
        )
        return 1
    width_version, _ = parse(args.width_input)
    if width_version != version:
        print(
            f"Unicode version mismatch: routing={version!r} "
            f"libghostty-width={width_version!r}",
            file=sys.stderr,
        )
        return 1
    generated = render(args.input, version, properties)
    if args.check:
        current = (
            args.output.read_text(encoding="utf-8") if args.output.is_file() else None
        )
        if current != generated:
            print(f"generated emoji table is stale: {args.output}", file=sys.stderr)
            return 1
        print(
            f"emoji and libghostty width tables match Unicode {version}: "
            f"{len(properties['Emoji'])} Emoji ranges, "
            f"{len(properties['Emoji_Presentation'])} presentation ranges"
        )
        return 0
    args.output.write_text(generated, encoding="utf-8")
    print(f"generated {args.output} from Unicode {version}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
