#!/bin/sh
# Print a sampler of SGR attributes, palettes, and underline styles.

Row()
{
        printf '%-28s \033[%sm%s\033[0m\n' "$1" "$2" "${3:-Sample text}"
}

printf 'Attributes\n'
Row 'normal' '0'
Row 'bold (1)' '1'
Row 'faint (2)' '2'
Row 'italic (3)' '3'
Row 'underline (4)' '4'
Row 'blink (5)' '5'
Row 'inverse (7)' '7'
Row 'hidden (8)' '8' 'hidden'
Row 'strikethrough (9)' '9'
Row 'double underline (21)' '21'
Row 'overline (53)' '53'
printf '\nUnderline styles (4:n) and colour (58)\n'
Row 'straight (4:1)' '4:1'
Row 'double (4:2)' '4:2'
Row 'curly (4:3)' '4:3'
Row 'dotted (4:4)' '4:4'
Row 'dashed (4:5)' '4:5'
Row 'curly red (4:3;58:2::255:0:0)' '4:3;58:2::255:0:0'
Row 'curly idx 4 (4:3;58:5:4)' '4:3;58:5:4'
printf '\n16 colours (30-37, 90-97)\n'
for c in 30 31 32 33 34 35 36 37; do printf '\033[%sm %3s \033[0m' "$c" "$c"; done; printf '\n'
for c in 90 91 92 93 94 95 96 97; do printf '\033[%sm %3s \033[0m' "$c" "$c"; done; printf '\n'
for c in 40 41 42 43 44 45 46 47; do printf '\033[%sm %3s \033[0m' "$c" "$c"; done; printf '\n'
for c in 100 101 102 103 104 105 106 107; do printf '\033[%sm %3s \033[0m' "$c" "$c"; done; printf '\n'
printf '\n256-colour cube (38;5;n)\n'
i=16
while [ "$i" -lt 232 ]; do
        printf '\033[48;5;%sm  \033[0m' "$i"
        i=$((i + 1))
        [ $(((i - 16) % 36)) -eq 0 ] && printf '\n'
done
printf 'greys: '
i=232
while [ "$i" -lt 256 ]; do printf '\033[48;5;%sm  \033[0m' "$i"; i=$((i + 1)); done
printf '\n\nTruecolour ramps (38;2;r;g;b and 38:2::r:g:b)\n'
i=0
while [ "$i" -lt 64 ]; do printf '\033[48;2;%s;%s;%sm \033[0m' "$((i * 4))" "$((255 - i * 4))" '96'; i=$((i + 1)); done
printf '  semicolon form\n'
i=0
while [ "$i" -lt 64 ]; do printf '\033[48:2::%s:%s:%sm \033[0m' "$((i * 4))" "$((255 - i * 4))" '96'; i=$((i + 1)); done
printf '  colon form\n'
printf '\nIf the colon-form ramp is missing or garbled, the terminal does not\nparse sub-parameters; if the truecolour ramps are banded, it quantizes.\n'
