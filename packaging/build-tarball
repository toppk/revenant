#!/usr/bin/env bash
# usage: packaging/build-tarball VERSION  -> dist/revenant-VERSION-linux-ARCH.tar.gz
set -euo pipefail
version=${1:?version}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
arch=$(uname -m)
name="revenant-$version-linux-$arch"
build="$root/build-release"
stage="$root/dist/stage/$name"

meson setup "$build" --reconfigure -Dlibghostty=enabled -Dbuildtype=release \
    -Drelease-version="$version"
meson compile -C "$build"
meson test -C "$build" --print-errorlogs
test "$("$build/revenant" --version)" = "revenant $version"
rm -rf "$stage" && mkdir -p "$stage"
cp "$build/revenant" "$stage/"
strip "$stage/revenant"
ln -s revenant "$stage/xterm+"
cp "$root/README.md" "$stage/"
cp "$root/LICENSE" "$stage/"
cp -r "$root/LICENSES" "$stage/"
tar -C "$root/dist/stage" -czf "$root/dist/$name.tar.gz" "$name"
rm -rf "$root/dist/stage"
echo "wrote dist/$name.tar.gz"
