#!/usr/bin/env bash
# usage: packaging/build-deb VERSION  -> dist/revenant_VERSION-1_ARCH.deb
set -euo pipefail
version=${1:?version}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

rm -rf debian && cp -r packaging/debian debian
trap 'rm -rf "$root/debian"' EXIT
cat > debian/changelog <<CHANGELOG
revenant ($version-1) unstable; urgency=medium

  * Release $version.

 -- Kenneth Topp <toppk@bllue.org>  $(date -R)
CHANGELOG

# Not dpkg-buildpackage: its dpkg-genbuildinfo walks the whole host package
# database, which costs minutes on CI, and the .buildinfo is discarded anyway.
REVENANT_RELEASE_VERSION="$version" DEB_RULES_REQUIRES_ROOT=no debian/rules binary
mkdir -p dist
mv ../revenant_"$version"-1_*.deb dist/
ls dist/*.deb
